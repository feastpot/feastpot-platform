/// Bank-initiated card chargebacks (Stripe `charge.dispute.*` events). Distinct
/// from the internal customer-vs-vendor `Dispute` model: this records the
/// Stripe Dispute object so finance has status + amount visibility without
/// opening the Stripe Dashboard. `status`/`reason` are stored as raw Stripe
/// strings to stay forward-compatible with new Stripe states. order/payment are
/// nullable so we still capture a chargeback even when no local row matches.
model Chargeback {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId               String?   @map("order_id") @db.Uuid
  paymentId             String?   @map("payment_id") @db.Uuid
  stripeDisputeId       String    @unique @map("stripe_dispute_id") @db.VarChar(100)
  stripeChargeId        String?   @map("stripe_charge_id") @db.VarChar(100)
  stripePaymentIntentId String?   @map("stripe_payment_intent_id") @db.VarChar(100)
  amountPence           Int       @map("amount_pence")
  currency              String    @default("GBP") @db.VarChar(3)
  status                String    @db.VarChar(50)
  reason                String?   @db.VarChar(100)
  evidenceDueBy         DateTime? @map("evidence_due_by") @db.Timestamptz
  openedAt              DateTime? @map("opened_at") @db.Timestamptz
  closedAt              DateTime? @map("closed_at") @db.Timestamptz
  /// Set once when a LOST chargeback's order finances have been reconciled
  /// (refund + credit Payment rows written). CAS guard against double-writes.
  reconciledAt          DateTime? @map("reconciled_at") @db.Timestamptz
  /// Set once when the evidence-deadline warning has been sent to finance,
  /// so the hourly monitor never re-alerts for the same dispute.
  evidenceWarnedAt      DateTime? @map("evidence_warned_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
  @@map("chargebacks")
}

/// Per-user, per-(channel, event) notification opt-outs. Rows are SPARSE: a
/// user only gets a row once they change a default. The canonical default +
/// "transactional / cannot disable" rules live in code
/// (notification-preferences.constants.ts), so a missing row falls back to the
/// coded default and pre-existing users need no backfill. `key` is the
/// notification EVENT name (== the BullMQ job name the processor dispatches on,
/// e.g. `order_confirmation`), `channel` is email|sms|whatsapp|push.
model NotificationPreference {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  channel   String   @db.VarChar(20)
  key       String   @db.VarChar(64)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, key])
  @@index([userId])
  @@map("notification_preferences")
}

