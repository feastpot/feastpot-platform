// ─── Order source attribution ─────────────────────────────────────────────────
// Enables source-based commission split. Attribution is immutable once written;
// all corrections require an admin compensating record. No update endpoint exists.

enum OrderSource {
  MARKETPLACE
  VENDOR_REFERRED
}

/// A unique share/referral link for a vendor, used to attribute traffic.
/// One per vendor (@@unique on vendorId). Slug is URL-safe and human-readable.
model VendorReferralLink {
  id         String   @id @default(cuid())
  vendorId   String   @unique @map("vendor_id") @db.Uuid
  slug       String   @unique @db.VarChar(80)
  qrCodeUrl  String?  @map("qr_code_url")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  vendor Vendor         @relation(fields: [vendorId], references: [id])
  clicks ReferralClick[]

  @@map("vendor_referral_links")
}

/// One row per visit to /v/[slug]. Privacy: IP is stored as a salted SHA-256 hash.
model ReferralClick {
  id             String   @id @default(cuid())
  referralLinkId String   @map("referral_link_id")
  sessionId      String   @map("session_id") @db.VarChar(128)
  userId         String?  @map("user_id") @db.Uuid
  ipHash         String   @map("ip_hash") @db.VarChar(64)
  userAgent      String?  @map("user_agent")
  clickedAt      DateTime @default(now()) @map("clicked_at") @db.Timestamptz

  referralLink VendorReferralLink @relation(fields: [referralLinkId], references: [id])

  @@index([sessionId, clickedAt])
  @@map("referral_clicks")
}

/// Immutable attribution record written inside the same DB transaction as order creation.
/// referralLinkId / referralClickId are stored as plain strings (no FK) to keep the
/// schema flexible and avoid hard deletes being blocked.
model OrderAttribution {
  id               String      @id @default(cuid())
  orderId          String      @unique @map("order_id") @db.Uuid
  source           OrderSource
  referralLinkId   String?     @map("referral_link_id")
  referralClickId  String?     @map("referral_click_id")
  isFirstOrder     Boolean     @map("is_first_order")
  attributedAt     DateTime    @default(now()) @map("attributed_at") @db.Timestamptz
  attributionReason String     @map("attribution_reason") @db.VarChar(64)

  order Order @relation(fields: [orderId], references: [id])

  @@index([source, attributedAt])
  @@map("order_attributions")
}

// ─── Source-based commission rate engine ─────────────────────────────────────
// Replaces hardcoded commissionBps (12%) on Vendor with a DB-driven rate table.
// Rates are IMMUTABLE once active; a change creates a new row with future
// effectiveFrom and closes the previous row's effectiveTo.
// Rate increases must go through the 15-day terms-notice flow (P2B / RED-102).

model CommissionRate {
  id            String      @id @default(cuid())
  source        OrderSource
  /// null means "applies regardless of isFirstOrder" (used for VENDOR_REFERRED).
  isFirstOrder  Boolean?    @map("is_first_order")
  ratePercent   Decimal     @db.Decimal(5, 2) @map("rate_percent")
  effectiveFrom DateTime    @map("effective_from") @db.Timestamptz
  effectiveTo   DateTime?   @map("effective_to") @db.Timestamptz
  createdBy     String      @map("created_by")
  note          String?
  /// Foreign key to RateScheduleEntry.key in the current RATE_SCHEDULE version.
  /// Used by the commission service to validate the entry is LIVE before use.
  /// Null for legacy rows seeded before RateScheduleEntry was introduced.
  rateKey       String?     @map("rate_key") @db.VarChar(64)

  orderCommissions OrderCommission[]

  @@index([source, effectiveFrom])
  @@map("commission_rates")
}

/// Per-order commission ledger, written in the same DB tx as order creation.
/// commissionRateId + ratePercent are stored for immutable audit so the correct
/// rate is always recoverable even after a rate change.
model OrderCommission {
  id                String      @id @default(cuid())
  orderId           String      @unique @map("order_id") @db.Uuid
  foodSubtotalPence Int         @map("food_subtotal_pence")
  ratePercent       Decimal     @db.Decimal(5, 2) @map("rate_percent")
  commissionPence   Int         @map("commission_pence")
  commissionRateId  String      @map("commission_rate_id")
  source            OrderSource
  isFirstOrder      Boolean     @map("is_first_order")
  calculatedAt      DateTime    @default(now()) @map("calculated_at") @db.Timestamptz

  order          Order          @relation(fields: [orderId], references: [id])
  commissionRate CommissionRate @relation(fields: [commissionRateId], references: [id])

  @@map("order_commissions")
}

// ─── Terms Versioning (P2B Regulation compliance) ────────────────────────────
// UK retained Platform to Business Regulation requires minimum 15 days notice
// before terms changes take effect; acceptances provide the audit trail.

enum TermsDocumentType {
  VENDOR_TERMS
  CUSTOMER_TERMS
  PRIVACY
  COOKIES
  ALLERGENS
  RATE_SCHEDULE
}

/// How a vendor accepted a version of the terms.
/// CLICKWRAP: ticked a checkbox after reading. ESIGNATURE: external tool.
/// DEEMED_CONTINUED_USE: acceptance inferred from continued platform use (editorial-only changes).
enum AcceptanceMethod {
  CLICKWRAP
  ESIGNATURE
  DEEMED_CONTINUED_USE
}

model TermsVersion {
  id           String            @id @default(cuid())
  documentType TermsDocumentType @map("document_type")
  version      String            @db.VarChar(32)
  /// Full document text in MDX format. SHA-256 of this field == contentHash.
  /// Immutable once published - corrections require a new version row.
  contentMdx   String            @map("content_mdx") @db.Text
  /// SHA-256 of contentMdx, computed on publish and never editable afterwards.
  contentHash  String            @map("content_hash") @db.VarChar(64)
  /// Plain-language summary of what changed in this version. Shown to vendors.
  changeSummary String           @map("change_summary") @db.Text
  /// true = material change (P2B 15-day notice required).
  /// false = editorial only (typo / formatting). Requires a written justification in changeSummary.
  isMaterial   Boolean           @default(true) @map("is_material")
  publishedAt  DateTime          @map("published_at") @db.Timestamptz
  /// When the terms take effect. Must be >= 15 days after publishedAt for isMaterial=true.
  effectiveAt  DateTime          @map("effective_at") @db.Timestamptz
  /// Set when a newer version supersedes this one. Exactly one version per documentType
  /// may have supersededAt IS NULL (the live version).
  supersededAt DateTime?         @map("superseded_at") @db.Timestamptz
  /// Staff member who published this version (email or name for audit trail).
  createdBy    String?           @map("created_by") @db.VarChar(255)
  /// For VENDOR_TERMS: "Reviewed and approved by [solicitor] on [date]".
  /// The publish endpoint rejects VENDOR_TERMS versions without this field.
  solicitorSignOff String?       @map("solicitor_sign_off") @db.Text

  acceptances          TermsAcceptance[]
  notices              TermsNotice[]
  rateScheduleEntries  RateScheduleEntry[]

  @@unique([documentType, version])
  @@index([effectiveAt])
  @@map("terms_versions")
}

model TermsAcceptance {
  id             String           @id @default(cuid())
  vendorId       String           @map("vendor_id") @db.Uuid
  termsVersionId String           @map("terms_version_id")
  acceptedAt     DateTime         @default(now()) @map("accepted_at") @db.Timestamptz
  ipAddress      String?          @map("ip_address")
  userAgent      String?          @map("user_agent") @db.Text
  /// Exact label text shown to the vendor at acceptance time.
  acceptanceText String?          @map("acceptance_text") @db.Text
  /// SHA-256 of the version's contentMdx at the moment of acceptance.
  contentHash    String?          @map("content_hash") @db.VarChar(64)
  /// Whether the vendor scrolled to the end of the terms pane before accepting.
  scrolledToEnd  Boolean          @default(false) @map("scrolled_to_end")
  method         AcceptanceMethod @default(CLICKWRAP)

  vendor       Vendor       @relation(fields: [vendorId], references: [id])
  termsVersion TermsVersion @relation(fields: [termsVersionId], references: [id])

  @@unique([vendorId, termsVersionId])
  @@index([vendorId, acceptedAt])
  @@map("terms_acceptances")
}

model TermsNotice {
  id             String        @id @default(cuid())
  vendorId       String        @map("vendor_id") @db.Uuid
  termsVersionId String        @map("terms_version_id")
  sentAt         DateTime      @default(now()) @map("sent_at") @db.Timestamptz
  channel        NoticeChannel
  deliveredAt    DateTime?     @map("delivered_at") @db.Timestamptz
  openedAt       DateTime?     @map("opened_at") @db.Timestamptz
  acknowledgedAt DateTime?     @map("acknowledged_at") @db.Timestamptz

  termsVersion TermsVersion @relation(fields: [termsVersionId], references: [id])

  @@index([vendorId, sentAt])
  @@map("terms_notices")
}

enum NoticeChannel {
  EMAIL
  DASHBOARD
  WHATSAPP
}

/// Canonical rate schedule entries linked to a RATE_SCHEDULE TermsVersion.
/// Every commission rate displayed on any surface must come from here.
/// LIVE entries are used in calculations. PLANNED, INCENTIVE, CUSTOMER_SIDE,
/// and OPTIONAL_ADDON entries are shown for transparency but never deducted
/// from vendor payouts (the commission service throws if a PLANNED entry is
/// resolved). A new TermsVersion row is required for any change (the
/// LEGAL-503 notice flow is triggered automatically).
model RateScheduleEntry {
  id          String     @id @default(cuid())
  versionId   String     @map("version_id")
  key         String     @db.VarChar(64)
  label       String     @db.VarChar(255)
  /// Human-readable rate display, e.g. "12%", "0% to 3%", "approx £19/mo".
  rateDisplay String     @map("rate_display") @db.VarChar(64)
  /// Numeric rate for calculation context. Null for non-percentage entries.
  rateValue   Decimal?   @map("rate_value") @db.Decimal(5, 2)
  /// What the rate is applied to, e.g. "food subtotal only".
  basis       String     @db.VarChar(255)
  /// VAT treatment note for transparency.
  vatNote     String     @map("vat_note") @db.VarChar(255)
  status      RateStatus
  sortOrder   Int        @map("sort_order")

  version     TermsVersion @relation(fields: [versionId], references: [id])

  @@unique([versionId, key])
  @@map("rate_schedule_entries")
}

enum RateStatus {
  /// Currently active and used in commission calculations.
  LIVE
  /// Announced but not yet in force. Commission service MUST NOT use these.
  PLANNED
  /// Time-limited promotional rate (e.g. founding cook programme).
  INCENTIVE
  /// Charged to customers, never deducted from vendor payout. Shown for transparency.
  CUSTOMER_SIDE
  /// Optional paid add-on (e.g. Vendor Pro subscription).
  OPTIONAL_ADDON
}

/// Customer waitlist capture for uncovered postcodes. Populated by the public
/// POST /coverage-interest endpoint when someone enters a postcode Feastpot
/// doesn't serve yet. Read-only from the admin console (waitlist size +
/// demand-by-postcode). `notified` flips true once ops emails the lead that a
/// vendor has gone live in their area.
model CoverageInterest {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String
  postcode         String
  name             String?
  marketingConsent Boolean? @map("marketing_consent")
  source           String?  @default("coverage-check")
  notified         Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([email, postcode])
  @@index([postcode])
  @@map("coverage_interests")
}

// ============================================================
// VENDOR VERIFICATION -- structured compliance record
// ============================================================

enum FhrsStatus {
  AWAITING_FIRST_INSPECTION
  RATED
  EXEMPT
  NOT_FOUND
}

enum VerificationState {
  VERIFIED
  RENEWAL_DUE
  SUSPENDED
}

/// One row per vendor once they have been through the verification gate.
/// Absent row = not yet verified (profile still renders, panel is omitted).
model VendorVerification {
  id                      String            @id @default(cuid())
  vendorId                String            @unique @map("vendor_id") @db.Uuid
  registrationNumber      String            @map("registration_number")
  registrationAuthority   String            @map("registration_authority")
  registrationConfirmedAt DateTime          @map("registration_confirmed_at") @db.Timestamptz
  fhrsRating              Int?              @map("fhrs_rating")
  fhrsRatingCheckedAt     DateTime?         @map("fhrs_rating_checked_at") @db.Timestamptz
  fhrsInspectionStatus    FhrsStatus        @map("fhrs_inspection_status")
  insuranceProvider       String?           @map("insurance_provider")
  insuranceValidUntil     DateTime?         @map("insurance_valid_until") @db.Timestamptz
  allergenTrainingHeld    Boolean           @default(false) @map("allergen_training_held")
  allergenTrainingUntil   DateTime?         @map("allergen_training_until") @db.Timestamptz
  idVerifiedAt            DateTime?         @map("id_verified_at") @db.Timestamptz
  overallState            VerificationState @map("overall_state")
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([overallState])
  @@map("vendor_verifications")
}

// ============================================================
// ENFORCEMENT - P2B statement of reasons (clause 14.1)
// ============================================================

enum EnforcementType {
  RESTRICTION
  SUSPENSION
  TERMINATION
}

/// P2B-compliant audit record for every enforcement action against a vendor.
/// A row MUST exist - with reasonNarrative >= 50 chars - before any listing
/// restriction, suspension, or termination takes effect.
/// See vendor terms clause 14.1 for the canonical reason code definitions.
/// Automated actions (document expiry, FHRS) flow through this table too.
model VendorEnforcementAction {
  id              String          @id @default(cuid())
  vendorId        String          @map("vendor_id") @db.Uuid
  actionType      EnforcementType @map("action_type")
  /// One of: FHRS_BELOW_THRESHOLD | DOCUMENT_EXPIRED | FOOD_SAFETY_CONCERN
  ///         MATERIAL_BREACH | REPEATED_COMPLAINTS | STRIPE_FLAG
  ///         PROHIBITED_CONDUCT | FRAUD
  reasonCode      String          @map("reason_code") @db.VarChar(64)
  /// Written statement of reasons - minimum 50 characters.
  reasonNarrative String          @map("reason_narrative") @db.Text
  /// Structured data: { priorStatus, documentTypes, ... }
  facts           Json            @default("{}")
  effectiveAt     DateTime        @map("effective_at") @db.Timestamptz
  /// Dispatched at or before effectiveAt for non-urgent; immediately after for urgent.
  noticeSentAt    DateTime?       @map("notice_sent_at") @db.Timestamptz
  /// Required for urgent reason codes only (FHRS_BELOW_THRESHOLD, FOOD_SAFETY_CONCERN,
  /// STRIPE_FLAG, FRAUD). Must state the public-safety or fraud basis explicitly.
  urgentBasis     String?         @map("urgent_basis") @db.Text
  /// Staff email or 'system' for automated triggers.
  issuedBy        String          @map("issued_by") @db.VarChar(255)
  /// Reference to a DisputeAppeal record if the vendor has lodged an appeal.
  appealId        String?         @map("appeal_id")
  /// Set when the action is revoked. Null means currently active.
  liftedAt        DateTime?       @map("lifted_at") @db.Timestamptz
  liftedBy        String?         @map("lifted_by") @db.VarChar(255)
  liftNote        String?         @map("lift_note") @db.Text
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, createdAt])
  @@index([vendorId, liftedAt])
  @@map("vendor_enforcement_actions")
}

// ============================================================
// FEASTPASS - consumer subscription
// ============================================================

enum FeastPassPlan {
  MONTHLY
  ANNUAL
}

enum FeastPassStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

/// One row per subscriber. userId is UNIQUE so a customer can only hold one
/// active subscription at a time. stripeCustomerId is preserved across
/// cancellations so the portal session works even after a lapse.
model FeastPassSubscription {
  id                   String          @id @default(cuid())
  userId               String          @unique @map("user_id") @db.Uuid
  stripeSubscriptionId String          @unique @map("stripe_subscription_id") @db.VarChar(255)
  stripeCustomerId     String          @map("stripe_customer_id") @db.VarChar(255)
  plan                 FeastPassPlan
  status               FeastPassStatus
  currentPeriodStart   DateTime        @map("current_period_start") @db.Timestamptz
  currentPeriodEnd     DateTime        @map("current_period_end") @db.Timestamptz
  cancelAtPeriodEnd    Boolean         @default(false) @map("cancel_at_period_end")
  startedAt            DateTime        @default(now()) @map("started_at") @db.Timestamptz
  cancelledAt          DateTime?       @map("cancelled_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, currentPeriodEnd])
  @@map("feast_pass_subscriptions")
}

/// One row per logged error incident from vendor/web/admin frontends.
/// ref uses the format FP-XXXX-XXXX so it is obviously an identifier (not a
/// random number) and vendors can quote it to support unambiguously. Support
/// can look up any ref in the admin /error-incidents page.
model ErrorIncident {
  id        String   @id
  ref       String   @unique @db.VarChar(15)
  app       String   @db.VarChar(20)
  route     String   @db.VarChar(255)
  message   String   @db.Text
  digest    String?  @db.VarChar(50)
  vendorId  String?  @map("vendor_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt(sort: Desc)])
  @@index([app, route, createdAt(sort: Desc)])
  @@map("error_incidents")
}

/// One row per order where the service fee was waived. Used for the cumulative
/// savings tracker on the account page and the admin health dashboard.
/// orderId is UNIQUE (upsert-safe): a re-queued job can never double-insert.
model FeastPassSaving {
  id         String   @id @default(cuid())
  userId     String   @map("user_id") @db.Uuid
  orderId    String   @unique @map("order_id") @db.Uuid
  savedPence Int      @map("saved_pence")
  savedAt    DateTime @default(now()) @map("saved_at") @db.Timestamptz

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, savedAt])
  @@map("feast_pass_savings")
}
