model User {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String     @unique @db.VarChar(255)
  phone         String?    @unique @db.VarChar(32)
  passwordHash  String?    @map("password_hash") @db.VarChar(255)
  firstName     String?    @map("first_name") @db.VarChar(100)
  lastName      String?    @map("last_name") @db.VarChar(100)
  role          UserRole   @default(customer)
  status        UserStatus @default(active)
  emailVerified Boolean    @default(false) @map("email_verified")
  phoneVerified Boolean    @default(false) @map("phone_verified")
  avatarUrl     String?    @map("avatar_url") @db.VarChar(500)
  lastLoginAt   DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  sessions                   Session[]
  addresses                  Address[]
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  inboxNotifications         InboxNotification[]
  vendorMemberships          VendorMember[]           @relation("VendorMemberUser")
  vendorInvitesSent          VendorMember[]           @relation("VendorMemberInviter")
  vendor                     Vendor?
  orders                     Order[]
  disputes                   Dispute[]
  payments                   Payment[]
  reviews                    Review[]
  loyaltyPoints              LoyaltyPoint[]
  referralsMade              Referral[]               @relation("ReferralReferrer")
  referralsGot               Referral[]               @relation("ReferralReferee")
  auditLogs                  AuditLog[]
  eventEnquiries             EventEnquiry[]
  pushSubscriptions          PushSubscription[]
  createdDiscountCodes       DiscountCode[]           @relation("CreatedDiscountCodes")
  reviewedVendorApplications VendorApplication[]      @relation("VendorApplicationReviewer")
  mfaRecoveryCodes           MfaRecoveryCode[]
  verifiedTrustSignals       VendorTrustSignal[]      @relation("TrustSignalVerifier")
  cateringBookings           CateringBooking[]        @relation("CateringBookingCustomer")
  feastPassSubscription      FeastPassSubscription?
  feastPassSavings           FeastPassSaving[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

// MfaRecoveryCode: single-use TOTP recovery codes for self-serve 2FA
// recovery. We store HMAC-SHA256(code, server pepper) - never the
// plaintext. A successful consume marks `usedAt` and the API then calls
// supabase.auth.admin.mfa.deleteFactor() so the user can sign in with
// just their password and re-enrol if they wish. Regenerating codes
// hard-deletes any prior unused rows so old codes cannot resurrect.
model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(128)
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([codeHash])
  @@map("mfa_recovery_codes")
}

model Session {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  refreshToken String    @unique @map("refresh_token") @db.VarChar(255)
  userAgent    String?   @map("user_agent") @db.VarChar(500)
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Address {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String?  @db.VarChar(100)
  line1     String   @db.VarChar(255)
  line2     String?  @db.VarChar(255)
  city      String   @db.VarChar(100)
  postcode  String   @db.VarChar(16)
  country   String   @default("GB") @db.VarChar(2)
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@index([postcode])
  @@map("addresses")
}

model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Notification {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel
  status    NotificationStatus  @default(queued)
  template  String              @db.VarChar(100)
  subject   String?             @db.VarChar(255)
  body      String
  metadata  Json?
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([channel])
  @@index([createdAt])
  @@map("notifications")
}

/// Durable fallback for notification enqueues: when Redis/Bull is down, the
/// event is persisted here instead of being dropped, and a cron retries the
/// enqueue until it succeeds. Rows are deleted on successful enqueue.
model NotificationOutbox {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventName     String   @map("event_name") @db.VarChar(100)
  payload       Json
  jobId         String?  @map("job_id") @db.VarChar(255)
  attempts      Int      @default(0)
  lastError     String?  @map("last_error")
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([nextAttemptAt])
  @@map("notification_outbox")
}

/// Vendor registration leads captured from the public become-a-vendor form.
/// Distinct from `Vendor` (which requires an authenticated User) - applicants
/// don't have accounts yet. Admin review converts an approved application
/// into a full Vendor + User pair.
model VendorApplication {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName             String                  @map("full_name") @db.VarChar(255)
  kitchenName          String                  @map("kitchen_name") @db.VarChar(255)
  email                String                  @db.VarChar(255)
  phone                String                  @db.VarChar(40)
  postcode             String                  @db.VarChar(16)
  cuisineType          String                  @map("cuisine_type") @db.VarChar(64)
  kitchenType          String                  @map("kitchen_type") @db.VarChar(40)
  hasFsaRegistration   Boolean                 @map("has_fsa_registration")
  foodStory            String
  instagram            String?                 @db.VarChar(255)
  marketingConsent     Boolean                 @default(true) @map("marketing_consent")
  status               VendorApplicationStatus @default(pending)
  reviewedAt           DateTime?               @map("reviewed_at") @db.Timestamptz
  reviewedById         String?                 @map("reviewed_by_id") @db.Uuid
  // adminNotes: free-form internal notes (visible to admins, never to the
  // applicant). Also doubles as the body of an "information_requested"
  // message - the email template surfaces it to the applicant verbatim.
  adminNotes           String?                 @map("admin_notes")
  // rejectionReason: surfaced to the applicant in the rejection email.
  // Separate from adminNotes so we never leak internal triage commentary.
  rejectionReason      String?                 @map("rejection_reason")
  // Populated by the approval flow when we provision the real Vendor row.
  // ON DELETE SET NULL so removing a vendor (rare, GDPR) doesn't erase the
  // permanent application record.
  vendorId             String?                 @unique @map("vendor_id") @db.Uuid
  // Vendor T&Cs acceptance audit. Nullable because pre-existing
  // applications were captured before the explicit-consent contract was
  // introduced; new submissions always populate both fields. Version is
  // a free-form tag (e.g. "2026-05") so legal can bump it without a
  // schema migration when terms change.
  acceptedTermsAt      DateTime?               @map("accepted_terms_at") @db.Timestamptz
  acceptedTermsVersion String?                 @map("accepted_terms_version") @db.VarChar(32)
  // T5 (Aug 2026) acquisition-form additions. Nullable because rows
  // predating the fields exist; new submissions are validated by the DTO
  // (hygiene registration required, radius/order types optional).
  deliveryRadiusMiles  Int?                    @map("delivery_radius_miles")
  hygieneRegNumber     String?                 @map("hygiene_reg_number") @db.VarChar(64)
  orderTypes           String[]                @default([]) @map("order_types")
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  reviewedBy User?   @relation("VendorApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  vendor     Vendor? @relation("VendorApplicationVendor", fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
  @@map("vendor_applications")
}

enum VendorApplicationStatus {
  pending
  under_review
  information_requested
  approved
  rejected
}

/// Anonymous log of every public vendor search. Powers admin "search trends"
/// + vendor-recruitment ("we get N searches/week for X but have no vendors").
/// Intentionally has NO userId/IP so it stays out of GDPR DSAR scope.
model SearchLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  query        String   @db.VarChar(200)
  postcode     String?  @db.VarChar(10)
  resultsCount Int      @map("results_count")
  searchedAt   DateTime @default(now()) @map("searched_at") @db.Timestamptz

  @@index([query, searchedAt(sort: Desc)])
  @@index([searchedAt(sort: Desc)])
  @@map("search_logs")
}

// Trust-signal + capacity data layer (Aug 2026). Native Postgres enums are
// used (repo convention - see OrderStatus / PayoutStatus etc.) rather than
// check constraints.
enum TrustSignalType {
  food_business_registration
  hygiene_rating
  identity_check
  allergen_information
  delivery_coverage
  event_catering_experience
  reliable_orders

  @@map("vendor_trust_signal_type")
}

enum TrustSignalStatus {
  not_provided
  submitted
  verified
  expired

  @@map("vendor_trust_signal_status")
}

enum CapacityType {
  family_pot
  party_tray
  event_catering
  meal_prep

  @@map("vendor_capacity_type")
}

model VendorTrustSignal {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId          String            @map("vendor_id") @db.Uuid
  signalType        TrustSignalType   @map("signal_type")
  status            TrustSignalStatus @default(not_provided)
  evidenceReference String?           @map("evidence_reference")
  verifiedAt        DateTime?         @map("verified_at") @db.Timestamptz
  verifiedBy        String?           @map("verified_by") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  verifier User?  @relation("TrustSignalVerifier", fields: [verifiedBy], references: [id])

  @@unique([vendorId, signalType])
  @@index([vendorId, status])
  @@map("vendor_trust_signals")
}

model VendorCapacity {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId         String       @map("vendor_id") @db.Uuid
  serviceDate      DateTime     @map("service_date") @db.Date
  capacityType     CapacityType @map("capacity_type")
  // CHECK constraints (total_slots > 0; 0 <= slots_taken <= total_slots)
  // live in the migration SQL - Prisma cannot express them.
  totalSlots       Int          @map("total_slots")
  slotsTaken       Int          @default(0) @map("slots_taken")
  preorderCutoffAt DateTime?    @map("preorder_cutoff_at") @db.Timestamptz
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, serviceDate, capacityType])
  @@map("vendor_capacity")
}

model Vendor {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String       @unique @map("user_id") @db.Uuid
  businessName       String       @map("business_name") @db.VarChar(255)
  slug               String       @unique @db.VarChar(255)
  description        String?
  cuisines           String[]     @db.VarChar(64)
  status             VendorStatus @default(pending)
  rating             Float        @default(0)
  ratingCount        Int          @default(0) @map("rating_count")
  reorderRatePct     Float        @default(0) @map("reorder_rate_pct")
  communityFavourite Boolean      @default(false) @map("community_favourite")
  commissionBps      Int          @default(1200) @map("commission_bps")
  stripeAccountId    String?      @map("stripe_account_id") @db.VarChar(100)
  payoutsEnabled     Boolean      @default(false) @map("payouts_enabled")
  approvedAt         DateTime?    @map("approved_at") @db.Timestamptz
  suspendedAt        DateTime?    @map("suspended_at") @db.Timestamptz

  // Availability & scheduling (T002).
  // openingDays uses 0=Sun … 6=Sat to match JavaScript Date#getDay(),
  // which is what both the customer checkout SlotPicker and the order
  // intake validator already use. Defaults keep behaviour identical to
  // the pre-T002 hardcoded OrderSlotsService defaults so unmigrated
  // vendors continue to work.
  openingDays              Int[]   @default([0, 1, 2, 3, 4, 5, 6]) @map("opening_days")
  slotOpenHour             Int     @default(9) @map("slot_open_hour")
  slotCloseHour            Int     @default(21) @map("slot_close_hour")
  prepLeadHours            Int     @default(24) @map("prep_lead_hours")
  maxOrdersPerDay          Int?    @map("max_orders_per_day")
  maxTraysPerDay           Int?    @map("max_trays_per_day")
  sameDayOrders            Boolean @default(false) @map("same_day_orders")
  largeOrderLeadHours      Int?    @map("large_order_lead_hours")
  largeOrderTrayThreshold  Int?    @map("large_order_tray_threshold")
  eventCateringManualQuote Boolean @default(false) @map("event_catering_manual_quote")


  // Business profile additions (T005). All optional/additive so existing
  // vendors keep working untouched.
  // - logoUrl / coverImageUrl: previously implicit; promoted to first-class
  //   columns so the profile editor can write to them via PATCH.
  // - specialities: short tags surfaced as pills on the customer page,
  //   distinct from cuisines (which are coarse categories).
  // - vendorStory: long-form bio rendered below the description.
  // - featuredDishes: free-text names highlighted at the top of the menu;
  //   not a foreign key to MenuItem so vendors can call out off-menu /
  //   seasonal favourites without a publishing round-trip.
  // - socialLinks: JSON blob keyed by network (instagram / tiktok / web /
  //   facebook / youtube). JSON keeps the schema flexible while the
  //   editor settles on which networks matter.
  logoUrl        String?  @map("logo_url")
  coverImageUrl  String?  @map("cover_image_url")
  specialities   String[] @default([]) @db.VarChar(64)
  vendorStory    String?  @map("vendor_story")
  featuredDishes String[] @default([]) @map("featured_dishes") @db.VarChar(120)
  socialLinks    Json?    @map("social_links")

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz
  /// Set to true on rows created by the seed script. Rows with this flag are
  /// removed by the purge migration before production go-live. Never set this
  /// on real vendor rows; the purge migration deletes isSeedData = true vendors
  /// together with all their menus, orders and reviews, regardless of status.
  isSeedData Boolean  @default(false) @map("is_seed_data")

  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  menus                Menu[]
  menuItems            MenuItem[]
  deliveryConfig       DeliveryConfig?
  documents            VendorDocument[]
  blackoutDates        BlackoutDate[]
  orders               Order[]
  payouts              Payout[]
  reviews              Review[]
  eventQuotes          EventQuote[]
  selectedForEnquiries EventEnquiry[]      @relation("EventEnquirySelectedVendor")
  discountCodes        DiscountCode[]
  amendments           OrderAmendment[]
  application          VendorApplication?  @relation("VendorApplicationVendor")
  members              VendorMember[]
  trustSignals         VendorTrustSignal[]
  capacity             VendorCapacity[]
  termsAcceptances     TermsAcceptance[]
  referralLink         VendorReferralLink?
  cateringBookings     CateringBooking[]
  verification         VendorVerification?
  enforcementActions   VendorEnforcementAction[]
  taxProfile           VendorTaxProfile?
  platformReports      PlatformReport[]

  @@index([status])
  @@index([slug])
  @@index([rating])
  @@index([communityFavourite])
  @@map("vendors")
}

// Dates a vendor is closed: holidays, personal time, fully booked, etc.
// One row per (vendor, calendar date) - the unique index lets us upsert
// idempotently from the vendor UI and lets the order-slot validator do a
// fast lookup by (vendorId, date).
model BlackoutDate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  date      DateTime @db.Date
  reason    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, date])
  @@index([vendorId, date])
  @@map("blackout_dates")
}

