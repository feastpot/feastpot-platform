{
  "name": "@feastpot/config",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./tsconfig/base": "./tsconfig.base.json",
    "./tsconfig/nextjs": "./tsconfig.nextjs.json",
    "./tsconfig/nestjs": "./tsconfig.nestjs.json",
    "./eslint/base": "./eslint-base.js",
    "./eslint/nextjs": "./eslint-nextjs.js",
    "./eslint/nestjs": "./eslint-nestjs.js",
    "./platform-facts": {
      "types": "./src/platform-facts.ts",
      "default": "./src/platform-facts.ts"
    },
    "./allergens": {
      "types": "./src/allergens.ts",
      "default": "./src/allergens.ts"
    },
    "./service-fee": {
      "types": "./src/service-fee.ts",
      "default": "./src/service-fee.ts"
    }
  },
  "typesVersions": {
    "*": {
      "platform-facts": ["./src/platform-facts.ts"],
      "allergens": ["./src/allergens.ts"],
      "service-fee": ["./src/service-fee.ts"]
    }
  },
  "scripts": {
    "lint": "node scripts/check-claims.mjs"
  },
  "files": [
    "src",
    "tsconfig.base.json",
    "tsconfig.nextjs.json",
    "tsconfig.nestjs.json",
    "eslint-base.js",
    "eslint-nextjs.js",
    "eslint-nestjs.js"
  ]
}
