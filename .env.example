# ═══════════════════════════════════════════════════════
# FEASTPOT — Environment Variables Reference (apps/api + Prisma + scripts)
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# This template lists only variables actually read by the server
# (process.env / ConfigService.get / Prisma env()). Frontend
# NEXT_PUBLIC_* vars live in apps/{web,vendor,admin}/.env.example.
# ═══════════════════════════════════════════════════════

# ── Supabase ────────────────────────────────────────────
# Dev and production use SEPARATE Supabase projects.
#   - DEV ref `zibmwuzxgydlvapiddhf` is for local development ONLY. The API
#     refuses to start if SUPABASE_URL still points at it while NODE_ENV is
#     production (see apps/api/src/main.ts) — this protects production data.
#   - PRODUCTION values below are set in the Replit deployment secrets, NOT here.
#
# DEV (local development only — never use this ref in production):
# SUPABASE_URL=https://zibmwuzxgydlvapiddhf.supabase.co
#
# PRODUCTION (set these in Replit deployment secrets):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJh...
SUPABASE_SERVICE_ROLE_KEY=eyJh...
# Pooled (Transaction pooler, :6543) connection used by the app at runtime
# (Prisma datasource url).
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres?pgbouncer=true
# Direct/Session-pooler (:5432) connection used for migrations (Prisma directUrl).
SUPABASE_DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Vercel env vars (set per-project in each Vercel dashboard, not here):
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...

# ── Stripe ──────────────────────────────────────────────
# ORGANISATIONAL STANDARD: store keys as ENCRYPTED Replit Secrets under
# environment-specific names. At boot the API copies the correct one into the
# canonical STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET based on NODE_ENV
# (production -> *_LIVE, otherwise -> *_TEST). Never place a live key in a
# plaintext / git-tracked env var.
STRIPE_SECRET_KEY_TEST=sk_test_...
STRIPE_SECRET_KEY_LIVE=sk_live_...
STRIPE_WEBHOOK_SECRET_TEST=whsec_...
STRIPE_WEBHOOK_SECRET_LIVE=whsec_...
# Canonical vars — auto-derived from the *_LIVE/*_TEST pair above. Set these
# directly only for a one-off local override (takes precedence over the pair):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Redis (Upstash / BullMQ) ────────────────────────────
REDIS_URL=rediss://default:password@your-host.upstash.io:6380

# ── Email (Resend) ──────────────────────────────────────
RESEND_API_KEY=re_test_...
EMAIL_FROM=hello@feastpot.co.uk
EMAIL_LOGO_URL=https://feastpot.co.uk/images/feastpot-logo.png

# ── SMS / WhatsApp (Twilio) ─────────────────────────────
TWILIO_ACCOUNT_SID=ACxx...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+447700000000
TWILIO_WHATSAPP_FROM=whatsapp:+447700000000

# WhatsApp Content SIDs (Twilio backend only — one per template that sends
# via WhatsApp). Created in Twilio Content Builder (Console → Messaging →
# Content Template Builder); each SID has the format HXxxxxxxxx...
# The provider reads TWILIO_CONTENT_SID_<internal template name>; a missing
# SID makes that single template skip WhatsApp (logged, non-fatal).
# NOTE: not needed for the Meta Cloud backend below — Meta sends pre-approved
# templates by name, so no Content SID is required there.
TWILIO_CONTENT_SID_order_confirmation=HXxx...
TWILIO_CONTENT_SID_order_accepted=HXxx...
TWILIO_CONTENT_SID_order_dispatched=HXxx...
TWILIO_CONTENT_SID_delivery_confirmed=HXxx...
TWILIO_CONTENT_SID_order_amendment_proposed=HXxx...
TWILIO_CONTENT_SID_event_quote_received=HXxx...
TWILIO_CONTENT_SID_event_reminder_72h=HXxx...
TWILIO_CONTENT_SID_event_balance_link=HXxx...
TWILIO_CONTENT_SID_payout_statement=HXxx...
TWILIO_CONTENT_SID_review_request=HXxx...

# ── WhatsApp (Meta Cloud API) ───────────────────────────
WHATSAPP_ACCESS_TOKEN=EAAxx...
WHATSAPP_PHONE_NUMBER_ID=1234567890

# ── Push Notifications (Web Push / VAPID) ───────────────
VAPID_PUBLIC_KEY=BPxx...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:push@feastpot.co.uk

# ── Platform config ─────────────────────────────────────
# Service fee in basis points (500 = 5%).
SERVICE_FEE_BPS=500
# Menu auto-approve: "true" for trusted cohort, "false" for self-serve review.
MENU_AUTO_APPROVE=true
# MFA recovery code pepper (generate with: openssl rand -hex 32).
MFA_RECOVERY_PEPPER=...

# ── URLs ────────────────────────────────────────────────
API_URL=http://localhost:3001
API_PUBLIC_URL=https://api.feastpot.co.uk
VENDOR_PORTAL_URL=https://vendor.feastpot.co.uk
ADMIN_URL=https://admin.feastpot.co.uk

# ── Bull Board (queue monitor) ──────────────────────────
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=change-me-in-production

# ── Ops / Alerts ────────────────────────────────────────
DLQ_ALERT_EMAIL=ops@feastpot.co.uk
VENDOR_APPLICATIONS_ADMIN_EMAIL=vendors@feastpot.co.uk
SENTRY_DSN=https://xxx@sentry.io/yyy

# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Seed / Test credentials (CI / local seeding only) ───
# Guard that must be "true" to allow `db:seed` against a prod NODE_ENV.
ALLOW_SEED_IN_PROD=false
TEST_ADMIN_EMAIL=soul@feastpot.co.uk
TEST_ADMIN_PASSWORD=...
CUSTOMER_EMAIL=customer@feastpot.co.uk
CUSTOMER_PASSWORD=...
VENDOR_EMAIL=vendor@feastpot.co.uk
VENDOR_PASSWORD=...
