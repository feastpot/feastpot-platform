# --------------------------------------------------------------------
# Customer PWA (apps/web)
# Copy to .env.local for dev. In Vercel, set the same keys per project.
# Anything NEXT_PUBLIC_* is inlined into the client bundle.
# --------------------------------------------------------------------

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend API. Dev fallback in src/lib/env.ts is http://localhost:3001.
# Prod: https://api.feastpot.co.uk (or https://feastpot-platform.replit.app
# until the api.feastpot.co.uk DNS is wired).
NEXT_PUBLIC_API_URL=

# Public Stripe key - used by @stripe/stripe-js in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only Stripe secret - never expose to the client.
STRIPE_SECRET_KEY=

# Used by metadataBase, sitemap, OG canonical URLs.
# Dev: http://localhost:3000   Prod: https://feastpot.co.uk
NEXT_PUBLIC_SITE_URL=

# Web Push (VAPID). Same key value as on the API.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Customer-facing support contacts (rendered on /help and footer).
NEXT_PUBLIC_SUPPORT_EMAIL=support@feastpot.co.uk
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Rendered on /legal/privacy. Replace before launch.
NEXT_PUBLIC_ICO_NUMBER=

# ---------------------------------------------------------------------------
# Playwright / e2e test variables (never commit real values; set in .env.local)
# ---------------------------------------------------------------------------

# Base URL for the web app under test (default: http://localhost:3000).
PLAYWRIGHT_BASE_URL=

# Vendor portal URL on a DISTINCT hostname for subdomain isolation tests (I2/I4).
# Example: http://vendor.localhost:3002
# Leave blank to skip the runtime isolation tests (static I1/I3 still run).
TEST_VENDOR_BASE_URL=

# Mailosaur credentials for real end-to-end email delivery tests (A1-real, E1-real).
# Create a free account at https://mailosaur.com; copy the API key and server ID.
# Tests are skipped when these are blank - the mock variants still run.
TEST_MAILOSAUR_API_KEY=
TEST_MAILOSAUR_SERVER_ID=

# Isolated test-environment identities for the customer Stripe smoke. CI requires
# every one of these values and fails rather than skipping when one is absent.
# Use a Stripe pk_test_ publishable key only; never place a Stripe secret here.
TEST_CUSTOMER_EMAIL=
TEST_CUSTOMER_PASSWORD=
TEST_CUSTOMER_VENDOR_ID=
TEST_CUSTOMER_VENDOR_SLUG=
TEST_CUSTOMER_MENU_ITEM_ID=
TEST_CUSTOMER_ADDRESS_ID=
